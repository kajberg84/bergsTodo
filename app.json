{
  "expo": {
    "name": "Bergs Todo",
    "slug": "bergs-todo",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.bergstodo.app",
      "adaptiveIcon": {
        "backgroundColor": "#173F35"
      }
    },
    "plugins": [["expo-speech-recognition", {
      "microphonePermission": "Allow Bergs Todo to hear your todo commands.",
      "speechRecognitionPermission": "Allow Bergs Todo to turn your spoken commands into text."
    }]]
  }
}
